RAIN_API_BASE_URL=https://api-dev.raincards.xyz/v1
RAIN_API_KEY=
RAIN_TEAM_ID=
RAIN_USER_ID=
RAIN_CONTRACT_ID=
RAIN_MODE=sandbox
RAIN_LIVE_EXECUTION_ENABLED=false

# Required for production live actions. Use a random value of at least 24
# characters; judges enter it once to mint a short-lived, HttpOnly session.
# A no-secret production rehearsal does not need one. Never commit the value.
POOL_DEMO_ACCESS_TOKEN=

# Monad Testnet only (chain 10143). Never use a mainnet-funded key here.
# Production with live Rain requires Monad. Set this to true for a competition
# rehearsal that must enforce the same gate locally.
MONAD_LIVE_REQUIRED=false
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_REGISTRY_ADDRESS=
MONAD_COMMITMENT_ID=
MONAD_PRIVATE_KEY=

# Optional: enables the live Responses API buyer-intent interpreter.
# Without a key the route stays functional in clearly labeled policy-fallback mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
